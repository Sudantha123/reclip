# Get API_ID and API_HASH from https://my.telegram.org
API_ID=123456
API_HASH=replace_with_your_api_hash

# Create a bot with @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token

# Pyrogram MTProto uploads: target maximum 2000 MB (~2 GB)
# Telegram/account/API limits still apply.
MAX_FILE_SIZE_MB=2000

# Limit simultaneous downloads on this VPS
BOT_MAX_CONCURRENT=2

# Seconds between progress message updates
PROGRESS_INTERVAL=2
